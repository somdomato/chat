# Matterbridge – ponte IRC ↔ Telegram (compilada do fonte, multi-arch nativo)
#
# Segue o mesmo padrão do Dockerfile.webircgateway: compila o binário Go a
# partir do repositório oficial em vez de puxar uma imagem/release pré-buildada,
# assim funciona em qualquer arquitetura sem depender de qual release tem
# binário pronto para ela.
FROM public.ecr.aws/docker/library/golang:1.23-alpine AS builder

RUN apk add --no-cache git

RUN git clone --depth 1 https://github.com/42wim/matterbridge.git /src
WORKDIR /src
RUN go build -o matterbridge

# Runtime
FROM public.ecr.aws/docker/library/alpine:3.21
RUN apk add --no-cache ca-certificates gettext

COPY --from=builder /src/matterbridge /opt/matterbridge/matterbridge
COPY docker/matterbridge.docker.toml.tmpl /opt/matterbridge/matterbridge.toml.tmpl
COPY docker/matterbridge-entrypoint.sh /opt/matterbridge/entrypoint.sh
RUN chmod +x /opt/matterbridge/entrypoint.sh

WORKDIR /opt/matterbridge
ENTRYPOINT ["/opt/matterbridge/entrypoint.sh"]
