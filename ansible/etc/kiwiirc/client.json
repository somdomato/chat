{
    "windowTitle": "Rádio Som do Mato",
    "startupScreen": "welcome",
    "hide_advanced": true,
    "warnOnExit": false,
    "kiwiServer": "/webirc",
    "restricted": true,
    "theme": "SDM-Dark",
    "themes": [
        { "name": "SDM", "url": "static/themes/sdm" },
        { "name": "SDM-Dark", "url": "static/themes/sdm-dark" }
    ],
    "startupOptions" : {
        "websocket": "wss://irc.somdomato.com/webirc",
        "channel": "#somdomato",
        "nick": "{sdm_?}",
        "showChannel": false
    },
    "plugins": [
        { "name": "conference", "url": "static/plugins/plugin-conference.js" }
    ],
    "conference": {
        "server": "meet.somdomato.com",
        "secure": false
    }
}
