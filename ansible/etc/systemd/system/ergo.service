[Unit]
Description=ergo
After=network.target
# If you are using MySQL for history storage, comment out the above line
# and uncomment these two instead (you must independently install and configure
# MySQL for your system):
# Wants=mysql.service
# After=network.target mysql.service

[Service]
#Type=notify
Type=simple
User=ergo
Group=ergo
WorkingDirectory=/var/lib/ergo
#ExecStart=/home/ergo/ergo run --conf /home/ergo/ircd.yaml
ExecStart=/opt/ergo/ergo run --conf /etc/ergo/ircd.yaml
ExecReload=/usr/bin/kill -HUP $MAINPID
Restart=on-failure
LimitNOFILE=1048576
#NotifyAccess=main
# Uncomment this for a hidden service:
# PrivateNetwork=true

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
