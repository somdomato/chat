[Unit]
Description=soju IRC bouncer service
After=network.target

[Service]
Type=simple
User=soju
Group=soju
WorkingDirectory=/var/lib/soju
StateDirectory=soju
LogsDirectory=soju
ConfigurationDirectory=soju
RuntimeDirectory=soju
Restart=always
ExecStart=/usr/local/bin/soju --config /etc/soju/config
ExecReload=/bin/kill -HUP $MAINPID

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/soju /var/log/soju /var/run/soju

[Install]
WantedBy=multi-user.target