#!/bin/bash
# SELinux Helper Script
# Facilita o gerenciamento do SELinux no Oracle Linux
# Autor: Lucas
# Data: 2026-01-27

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

show_help() {
    echo -e "${BLUE}=== SELinux Helper - Guia de Uso ===${NC}\n"
    echo "Uso: selinux-helper [comando] [opções]"
    echo ""
    echo -e "${GREEN}Comandos disponíveis:${NC}"
    echo ""
    echo "  status                    - Mostra o status atual do SELinux"
    echo "  check-denials             - Verifica negações recentes do SELinux"
    echo "  check-file <caminho>      - Verifica o contexto de um arquivo"
    echo "  fix-web <diretório>       - Corrige contexto para conteúdo web (Nginx/Apache)"
    echo "  fix-binary <arquivo>      - Corrige contexto para executável/binário"
    echo "  fix-service <nome>        - Analisa e cria política para um serviço"
    echo "  allow-httpd-network       - Permite que httpd faça conexões de rede"
    echo "  add-port <porta> <tipo>   - Adiciona porta ao SELinux (ex: 8088 http)"
    echo "  create-policy <serviço>   - Cria política customizada a partir de logs"
    echo "  restore <caminho>         - Restaura contexto padrão de um arquivo/dir"
    echo ""
    echo -e "${YELLOW}Exemplos:${NC}"
    echo "  selinux-helper status"
    echo "  selinux-helper check-file /opt/ergo/ergo"
    echo "  selinux-helper fix-web /var/www/irc.somdomato.com"
    echo "  selinux-helper fix-binary /opt/webircgateway/webircgateway"
    echo "  selinux-helper fix-service webircgateway"
    echo "  selinux-helper add-port 6697 ircd"
    echo "  selinux-helper create-policy ergo"
    echo ""
}

check_root() {
    if [ "$EUID" -ne 0 ]; then 
        echo -e "${RED}[ERRO] Este comando precisa ser executado como root${NC}"
        echo "Use: sudo selinux-helper $@"
        exit 1
    fi
}

show_status() {
    echo -e "${BLUE}=== Status do SELinux ===${NC}\n"
    
    echo -e "${GREEN}Modo atual:${NC}"
    getenforce
    echo ""
    
    echo -e "${GREEN}Configuração permanente:${NC}"
    grep "^SELINUX=" /etc/selinux/config
    echo ""
    
    echo -e "${GREEN}Booleans ativos (http):${NC}"
    getsebool -a | grep httpd | grep " on"
    echo ""
}

check_denials() {
    echo -e "${BLUE}=== Verificando Negações Recentes do SELinux ===${NC}\n"
    
    DENIALS=$(ausearch -m avc -ts recent 2>/dev/null)
    
    if [ -z "$DENIALS" ]; then
        echo -e "${GREEN}✓ Nenhuma negação recente encontrada${NC}"
    else
        echo -e "${YELLOW}⚠ Negações encontradas:${NC}\n"
        ausearch -m avc -ts recent | grep -E "(denied|avc:)" --color=always | head -20
        echo ""
        echo -e "${BLUE}Dica: Use 'selinux-helper create-policy <serviço>' para criar política${NC}"
    fi
}

check_file() {
    if [ -z "$1" ]; then
        echo -e "${RED}[ERRO] Especifique um arquivo ou diretório${NC}"
        echo "Uso: selinux-helper check-file <caminho>"
        exit 1
    fi
    
    echo -e "${BLUE}=== Verificando Contexto SELinux ===${NC}\n"
    echo -e "${GREEN}Arquivo/Diretório:${NC} $1"
    echo ""
    
    if [ ! -e "$1" ]; then
        echo -e "${RED}[ERRO] Arquivo/diretório não existe${NC}"
        exit 1
    fi
    
    ls -lZ "$1"
    echo ""
    
    # Explicar o contexto
    CONTEXT=$(ls -Z "$1" | awk '{print $1}' | head -1)
    echo -e "${YELLOW}Contexto atual:${NC} $CONTEXT"
    echo ""
    
    case "$CONTEXT" in
        *httpd_sys_content_t*)
            echo -e "${GREEN}✓ Contexto correto para conteúdo web${NC}"
            ;;
        *bin_t*)
            echo -e "${GREEN}✓ Contexto correto para executável${NC}"
            ;;
        *user_home_t*|*admin_home_t*)
            echo -e "${YELLOW}⚠ Contexto de diretório home - pode causar problemas com serviços${NC}"
            ;;
        *user_tmp_t*|*tmp_t*)
            echo -e "${RED}✗ Contexto temporário - impedirá execução por serviços${NC}"
            ;;
        *)
            echo -e "${YELLOW}? Contexto desconhecido - verifique se está correto${NC}"
            ;;
    esac
}

fix_web() {
    check_root
    
    if [ -z "$1" ]; then
        echo -e "${RED}[ERRO] Especifique um diretório${NC}"
        echo "Uso: selinux-helper fix-web <diretório>"
        exit 1
    fi
    
    echo -e "${BLUE}=== Corrigindo Contexto para Conteúdo Web ===${NC}\n"
    echo -e "${GREEN}Diretório:${NC} $1"
    echo ""
    
    # Definir política permanente
    echo -e "${YELLOW}[1/3] Definindo política permanente...${NC}"
    semanage fcontext -a -t httpd_sys_content_t "$1(/.*)?" 2>/dev/null || \
        semanage fcontext -m -t httpd_sys_content_t "$1(/.*)?"
    
    # Aplicar contexto
    echo -e "${YELLOW}[2/3] Aplicando contexto...${NC}"
    restorecon -Rv "$1"
    
    # Ajustar permissões
    echo -e "${YELLOW}[3/3] Ajustando permissões...${NC}"
    chown -R nginx:nginx "$1"
    chmod -R 755 "$1"
    find "$1" -type f -exec chmod 644 {} \;
    
    echo ""
    echo -e "${GREEN}✓ Contexto web aplicado com sucesso!${NC}"
    echo -e "${BLUE}Contexto final:${NC}"
    ls -lZ "$1" | head -5
}

fix_binary() {
    check_root
    
    if [ -z "$1" ]; then
        echo -e "${RED}[ERRO] Especifique um arquivo executável${NC}"
        echo "Uso: selinux-helper fix-binary <arquivo>"
        exit 1
    fi
    
    echo -e "${BLUE}=== Corrigindo Contexto para Executável ===${NC}\n"
    echo -e "${GREEN}Arquivo:${NC} $1"
    echo ""
    
    # Contexto temporário
    echo -e "${YELLOW}[1/3] Aplicando contexto temporário...${NC}"
    chcon -t bin_t "$1"
    
    # Definir política permanente
    echo -e "${YELLOW}[2/3] Definindo política permanente...${NC}"
    semanage fcontext -a -t bin_t "$1" 2>/dev/null || \
        semanage fcontext -m -t bin_t "$1"
    
    # Restaurar com nova política
    echo -e "${YELLOW}[3/3] Aplicando política...${NC}"
    restorecon -v "$1"
    
    # Garantir permissão de execução
    chmod +x "$1"
    
    echo ""
    echo -e "${GREEN}✓ Contexto de executável aplicado com sucesso!${NC}"
    echo -e "${BLUE}Contexto final:${NC}"
    ls -lZ "$1"
}

fix_service() {
    check_root
    
    if [ -z "$1" ]; then
        echo -e "${RED}[ERRO] Especifique o nome do serviço${NC}"
        echo "Uso: selinux-helper fix-service <nome>"
        exit 1
    fi
    
    echo -e "${BLUE}=== Analisando e Corrigindo Serviço ===${NC}\n"
    echo -e "${GREEN}Serviço:${NC} $1"
    echo ""
    
    # Verificar negações
    echo -e "${YELLOW}[1/2] Procurando negações do SELinux...${NC}"
    DENIALS=$(ausearch -m avc -ts recent 2>/dev/null | grep "$1")
    
    if [ -z "$DENIALS" ]; then
        echo -e "${GREEN}✓ Nenhuma negação encontrada para este serviço${NC}"
        exit 0
    fi
    
    echo -e "${RED}Negações encontradas:${NC}"
    echo "$DENIALS" | head -5
    echo ""
    
    # Criar política
    echo -e "${YELLOW}[2/2] Criando política customizada...${NC}"
    ausearch -m avc -ts recent | grep "$1" | audit2allow -M "${1}_policy"
    
    if [ -f "${1}_policy.pp" ]; then
        semodule -i "${1}_policy.pp"
        echo ""
        echo -e "${GREEN}✓ Política criada e instalada!${NC}"
        echo -e "${BLUE}Arquivo de política:${NC} ${1}_policy.pp"
        echo ""
        echo -e "${YELLOW}Reinicie o serviço:${NC} systemctl restart $1"
    else
        echo -e "${RED}✗ Falha ao criar política${NC}"
        exit 1
    fi
}

allow_httpd_network() {
    check_root
    
    echo -e "${BLUE}=== Permitindo Conexões de Rede para HTTPD ===${NC}\n"
    echo -e "${YELLOW}Isso permite que Nginx/Apache façam proxy para outros serviços${NC}\n"
    
    setsebool -P httpd_can_network_connect 1
    
    echo -e "${GREEN}✓ httpd_can_network_connect ativado permanentemente${NC}"
    echo ""
    echo "Status atual dos booleans HTTP:"
    getsebool -a | grep httpd_can_network
}

add_port() {
    check_root
    
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo -e "${RED}[ERRO] Especifique porta e tipo${NC}"
        echo "Uso: selinux-helper add-port <porta> <tipo>"
        echo ""
        echo "Tipos comuns:"
        echo "  http      - Portas HTTP/HTTPS"
        echo "  ircd      - Portas IRC"
        echo "  ssh       - Portas SSH"
        exit 1
    fi
    
    PORT=$1
    TYPE="${2}_port_t"
    
    echo -e "${BLUE}=== Adicionando Porta ao SELinux ===${NC}\n"
    echo -e "${GREEN}Porta:${NC} $PORT"
    echo -e "${GREEN}Tipo:${NC} $TYPE"
    echo ""
    
    semanage port -a -t "$TYPE" -p tcp "$PORT" 2>/dev/null || \
        semanage port -m -t "$TYPE" -p tcp "$PORT"
    
    echo -e "${GREEN}✓ Porta adicionada com sucesso!${NC}"
    echo ""
    echo "Portas do tipo $TYPE:"
    semanage port -l | grep "$TYPE"
}

create_policy() {
    check_root
    
    if [ -z "$1" ]; then
        echo -e "${RED}[ERRO] Especifique o nome do serviço/aplicação${NC}"
        echo "Uso: selinux-helper create-policy <nome>"
        exit 1
    fi
    
    echo -e "${BLUE}=== Criando Política SELinux Customizada ===${NC}\n"
    echo -e "${GREEN}Nome:${NC} $1"
    echo ""
    
    # Salvar negações em arquivo
    echo -e "${YELLOW}[1/3] Coletando negações do audit log...${NC}"
    ausearch -m avc -ts recent > "/tmp/${1}_denials.log" 2>/dev/null
    
    if [ ! -s "/tmp/${1}_denials.log" ]; then
        echo -e "${RED}✗ Nenhuma negação encontrada no audit log${NC}"
        echo -e "${BLUE}Dica: Execute o serviço/aplicação primeiro para gerar logs${NC}"
        exit 1
    fi
    
    # Gerar política
    echo -e "${YELLOW}[2/3] Gerando módulo de política...${NC}"
    audit2allow -M "${1}_custom" -i "/tmp/${1}_denials.log"
    
    if [ ! -f "${1}_custom.pp" ]; then
        echo -e "${RED}✗ Falha ao gerar política${NC}"
        exit 1
    fi
    
    # Instalar política
    echo -e "${YELLOW}[3/3] Instalando política...${NC}"
    semodule -i "${1}_custom.pp"
    
    echo ""
    echo -e "${GREEN}✓ Política criada e instalada com sucesso!${NC}"
    echo ""
    echo -e "${BLUE}Arquivos gerados:${NC}"
    echo "  ${1}_custom.te  - Política em texto"
    echo "  ${1}_custom.pp  - Política compilada"
    echo ""
    echo -e "${YELLOW}Para remover esta política:${NC}"
    echo "  semodule -r ${1}_custom"
}

restore_context() {
    check_root
    
    if [ -z "$1" ]; then
        echo -e "${RED}[ERRO] Especifique um caminho${NC}"
        echo "Uso: selinux-helper restore <caminho>"
        exit 1
    fi
    
    echo -e "${BLUE}=== Restaurando Contexto Padrão ===${NC}\n"
    echo -e "${GREEN}Caminho:${NC} $1"
    echo ""
    
    restorecon -Rv "$1"
    
    echo ""
    echo -e "${GREEN}✓ Contexto restaurado!${NC}"
}

# Main
case "$1" in
    status)
        show_status
        ;;
    check-denials)
        check_denials
        ;;
    check-file)
        check_file "$2"
        ;;
    fix-web)
        fix_web "$2"
        ;;
    fix-binary)
        fix_binary "$2"
        ;;
    fix-service)
        fix_service "$2"
        ;;
    allow-httpd-network)
        allow_httpd_network
        ;;
    add-port)
        add_port "$2" "$3"
        ;;
    create-policy)
        create_policy "$2"
        ;;
    restore)
        restore_context "$2"
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        echo -e "${RED}Comando desconhecido: $1${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac

# 1. Verificar status geral do SELinux
#selinux-helper status

# 2. Corrigir o KiwiIRC
#sudo selinux-helper fix-web /var/www/irc.somdomato.com

# 3. Corrigir o webircgateway
#sudo selinux-helper fix-binary /opt/webircgateway/webircgateway

# 4. Corrigir o Ergo
#sudo selinux-helper fix-binary /opt/ergo/ergo

# 5. Permitir Nginx fazer proxy
#sudo selinux-helper allow-httpd-network

# 6. Adicionar porta do IRC
#sudo selinux-helper add-port 6697 ircd

# 7. Verificar negações recentes
#selinux-helper check-denials

# 8. Criar política para um serviço com problemas
#sudo selinux-helper fix-service webircgateway

# 9. Verificar contexto de um arquivo
#selinux-helper check-file /opt/ergo/ergo

# 10. Restaurar contexto padrão
#sudo selinux-helper restore /var/www/irc.somdomato.com
