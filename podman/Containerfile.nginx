# Nginx + KiwiIRC + Gamja
# Stage 1: Build do Gamja (fonte em ansible/usr/share/gamja/)
FROM public.ecr.aws/docker/library/node:22-alpine AS gamja-builder

WORKDIR /gamja
COPY ansible/usr/share/gamja/package*.json ./
RUN npm ci

COPY ansible/usr/share/gamja/ ./
# Sobrescreve config.json com versão Podman
COPY podman/gamja.config.json ./config.json
RUN npm run build

# Stage 1b: Build do plugin de conferência (kiwiirc/plugin-conference)
# Commit fixado para build reprodutível (projeto não publica tags/releases)
FROM public.ecr.aws/docker/library/node:22-alpine AS conference-builder

RUN apk add --no-cache git
RUN git clone https://github.com/kiwiirc/plugin-conference.git /conference \
    && cd /conference \
    && git checkout d32b1890b21329837c33a33638dcf24372573efa

WORKDIR /conference
RUN npm install
RUN npm run build

# Stage 2: Nginx com KiwiIRC + Gamja
FROM public.ecr.aws/docker/library/nginx:alpine

RUN apk add --no-cache curl unzip

# Baixa KiwiIRC v1.7.1 (mesma versão do playbook Ansible)
RUN curl -fsSL \
    "https://github.com/kiwiirc/kiwiirc/releases/download/v1.7.1/kiwiirc-client_v1.7.1-2_any.zip" \
    -o /tmp/kiwiirc.zip \
    && mkdir -p /usr/share/kiwiirc \
    && unzip /tmp/kiwiirc.zip -d /tmp/kiwiirc_extract/ \
    && mv /tmp/kiwiirc_extract/kiwiirc_v1.7.1-2/* /usr/share/kiwiirc/ \
    && rm -rf /tmp/kiwiirc.zip /tmp/kiwiirc_extract \
    && apk del unzip curl

# Temas e assets customizados (sdm, sdm-dark, favicon etc.)
# Remove o symlink config.json -> /etc/kiwiirc/client.json antes de copiar os arquivos
RUN rm -f /usr/share/kiwiirc/static/config.json
COPY ansible/usr/share/kiwiirc/static/ /usr/share/kiwiirc/static/

# Configuração personalizada do KiwiIRC (Podman: sem URL hardcoded, usa /webirc relativo)
RUN rm -f /usr/share/kiwiirc/static/config.json
COPY podman/kiwiirc.client.json /usr/share/kiwiirc/static/config.json

# Gamja build
COPY --from=gamja-builder /gamja/dist /usr/share/gamja/dist

# Plugin de conferência (Jitsi Meet) do KiwiIRC
COPY --from=conference-builder /conference/dist/plugin-conference.js /usr/share/kiwiirc/static/plugins/plugin-conference.js

# Configuração do Nginx
COPY podman/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 8080 8090
